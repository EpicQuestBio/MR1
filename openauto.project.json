{
  "project_id": "mr1",
  "name": "MR1 Nanopore Sequencing Reader",
  "version": "1.0.0",
  "description": "High-throughput solid-state and biological nanopore sensing platform combining ultra-low noise analog front-end TIA, digital motherboard, and PDMS microfluidic flowcells.",
  "root_path": ".",
  "active_board": "amplifier",
  "boards": {
    "amplifier": {
      "name": "LMP7721 Analog Frontend",
      "path": "Amplifier/Amplifier.kicad_pcb",
      "schematic_path": "Amplifier/Amplifier.kicad_sch",
      "role": "Analog Transimpedance Amplifier (TIA)",
      "substrate": {
        "material": "PTFE / Rogers RO4350B",
        "er": 2.1,
        "loss_tangent": 0.001,
        "thickness_mm": 0.8
      },
      "spice": {
        "transimpedance_gain_ohms": 1000000000.0,
        "feedback_cap_pf": 0.15,
        "bandwidth_khz": 100
      },
      "fluidic_coupling": {
        "target_ref": "H1",
        "type": "well_interface",
        "pos": [
          0.0,
          0.0,
          3.8
        ]
      }
    },
    "mr1": {
      "name": "MR1 Digital & Power Motherboard",
      "path": "MR1/MR1.kicad_pcb",
      "schematic_path": "MR1/MR1.kicad_sch",
      "role": "Digital Signal Processing, MCU & Power Management",
      "substrate": {
        "material": "FR4 High-TG",
        "er": 4.3,
        "loss_tangent": 0.02,
        "thickness_mm": 1.6
      }
    },
    "pump": {
      "name": "MR1 Pump & USB-PD Hub",
      "path": "Pump/Pump.kicad_pcb",
      "schematic_path": "Pump/Pump.kicad_sch",
      "role": "USB Power Delivery Sink, Clean 5V Output, STM32 Fluidic Pump Controller & Pressure Monitoring",
      "substrate": {
        "material": "FR4 High-TG",
        "er": 4.3,
        "loss_tangent": 0.02,
        "thickness_mm": 1.6
      }
    },
    "interposer": {
      "name": "PTFE Microfluidic Interposer Board",
      "path": "Interposer/Interposer.kicad_pcb",
      "schematic_path": "Interposer/Interposer.kicad_sch",
      "role": "Passive Microfluidic Flow Cell Interposer & Electrode Pogo Interface",
      "substrate": {
        "material": "PTFE / Rogers RO4350B",
        "er": 2.1,
        "loss_tangent": 0.0002,
        "thickness_mm": 0.8,
        "copper_finish": "ENIG"
      },
      "pogo_interface": {
        "target_ref": "J_POGO1",
        "pin_count": 6,
        "pitch_mm": 5.0,
        "contact_force_n": 0.8,
        "gold_plating_microinches": 50,
        "leakage_target_fa": 10,
        "pin_map": {
          "1": "WE_POS (Working Electrode positive drive)",
          "2": "WS_CIS (Working Sense probe)",
          "3": "GNDA_FLOAT (Floating Analog Ground)",
          "4": "RE_TRANS (Reference / Counter Sense probe)",
          "5": "CE_GNDA (Counter Electrode return to GNDA)",
          "6": "WEEP_MOAT (Perimeter leak detector)"
        }
      },
      "electrochemical_cell": {
        "configuration": "4-electrode Kelvin concentric",
        "working_terminal": "positive (WE_POS)",
        "counter_terminal": "GNDA (CE_GNDA)",
        "working_sense": "WS_CIS",
        "reference_sense": "RE_TRANS",
        "floating_ground": "GNDA_FLOAT",
        "inner_sense_radius_mm": [
          5.0,
          5.8
        ],
        "outer_drive_radius_mm": [
          6.9,
          8.5
        ],
        "aperture_window_mm": 6.2
      },
      "fluidic_coupling": {
        "target_ref": "H1",
        "type": "well_interface",
        "pos": [
          0.0,
          0.0,
          3.8
        ]
      },
      "geometry": {
        "width_mm": 55.004,
        "height_mm": 51.962,
        "center_x_mm": 164.5,
        "center_y_mm": 58.494
      }
    }
  },
