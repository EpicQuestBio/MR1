			(plotpadnumbers no)
			(hidednponfab no)
			(sketchdnponfab yes)
			(crossoutdnponfab yes)
			(subtractmaskfromsilk no)
			(outputformat 3)
			(mirror no)
			(drillshape 0)
			(scaleselection 1)
			(outputdirectory "/home/loki/Projects/daemon-pore/Amplifier/")
