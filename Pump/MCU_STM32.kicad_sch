	(text "=== STM32G431CBU6 ARM CORTEX-M4 MICROCONTROLLER ===\nPackage: UFQFPN-48 (7x7mm)\n- I2C1: STUSB4500 PD Sink & Honeywell TruStability Pressure Transducers\n- I2C2: USB-C SBU Inter-module communication to MR1 Reader\n- TIM1 CH1/CH2: Precision PWM speed control for Dual Peristaltic Pumps\n- GPIO EXTI: Hardware Emergency Cutoff line (leak detection shutoff < 1ms)\n- USB_SEL_PASS: Controls TS3USB221 USB pass-through switch for 100 kHz streaming"
		(at 60.0 30.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a2020001-0000-4000-8000-000000000001")
	)

	(text "=== SWD DEBUG & PROGRAMMING INTERFACE ===\nStandard ARM Cortex SWD Header (SWDIO, SWCLK, NRST, 3V3, GND)"
		(at 60.0 95.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a2020001-0000-4000-8000-000000000002")
	)

	(text "=== STATUS & DIAGNOSTIC LEDS ===\n- LED_PD_READY: Green (Negotiated 9V/12V PD contract active)\n- LED_MR1_5V: Blue (Clean 5V rail enabled to MR1 reader)\n- LED_PUMP1: Yellow (Cis chamber pump running)\n- LED_PUMP2: Yellow (Trans chamber recirculation pump running)\n- LED_FAULT: Red (Occlusion / overpressure or leak emergency stop tripped)"
		(at 60.0 135.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a2020001-0000-4000-8000-000000000003")
	)
