	(text "=== PUMP 1 MOTOR DRIVER (U8: TI DRV8837C) ===\nMotor: Ditao Peristaltic Pump 1 (Cis Feed Line)\nDrive: Low-RDSon Synchronous H-Bridge (0.35 ohm)\nCurrent: 1.0A continuous, 1.8A peak\nControl Interface: PWM speed + DIR direction\nConnector: J_PUMP1 (JST-XH 2.54mm 2-pin keyed header)"
		(at 60.0 30.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a4020001-0000-4000-8000-000000000001")
	)

	(text "=== PUMP 2 MOTOR DRIVER (U9: TI DRV8837C) ===\nMotor: Ditao Peristaltic Pump 2 (Trans Recirculation / Waste Line)\nDrive: Low-RDSon Synchronous H-Bridge (0.35 ohm)\nCurrent: 1.0A continuous, 1.8A peak\nControl Interface: PWM speed + DIR direction\nConnector: J_PUMP2 (JST-XH 2.54mm 2-pin keyed header)"
		(at 60.0 85.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a4020001-0000-4000-8000-000000000002")
	)

	(text "=== HARDWARE EMERGENCY CUTOFF (nSLEEP GATING) ===\nWhen ESTOP_TRIGGER_ goes low (leak detected at weep moats or host emergency),\nnSLEEP pins of both drivers are immediately pulled low via hardware gate,\ndisabling all H-bridge outputs in < 1 microsecond without waiting for software."
		(at 60.0 140.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a4020001-0000-4000-8000-000000000003")
	)
