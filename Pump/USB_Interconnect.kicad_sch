	(text "=== J1_HOST: USB-C RECEPTACLE (HOST / POWER DELIVERY IN) ===\nLocation: Back Wall Left (X = -15.0 mm, Y = +44.0 mm on PCB)\nPins:\n- VBUS (A4, A9, B4, B9): Connected to +VBUS_PD rail\n- GND (A1, A12, B1, B12): System Power Ground\n- CC1 (A5) / CC2 (B5): Connected to STUSB4500 PD controller\n- D+ (A6, B6) / D- (A7, B7): Connected to TS3USB221 Common USB port\n- Shield: Chassis Ground with 1M // 4.7nF ESD bleed"
		(at 60.0 30.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a5020001-0000-4000-8000-000000000001")
	)

	(text "=== J2_MR1: USB-C RECEPTACLE (DEVICE OUT / MR1 READER LINK) ===\nLocation: Back Wall Right (X = +15.0 mm, Y = +44.0 mm on PCB)\nPins:\n- VBUS: Delivers regulated +5V_MR1_CLEAN (up to 2.0A)\n- GND: Signal & Power Ground\n- CC1 / CC2: 56k pull-ups (advertises 5V Source capability)\n- D+ / D-: Connected to TS3USB221 Pass-Through port\n- SBU1 (A8) / SBU2 (B8): Connected to SBU I2C Auto-Cross Switch"
		(at 60.0 80.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a5020001-0000-4000-8000-000000000002")
	)

	(text "=== HIGH-SPEED USB 2.0 PASS-THROUGH SWITCH (U10: TI TS3USB221) ===\nBandwidth: > 1.1 GHz (Ultra-low differential insertion loss < 0.5dB)\nOperation:\n- Normal Mode (USB_SEL_PASS = HIGH): Connects Host USB (J1) straight through to MR1 (J2).\n  The ESP32-S3 on MR1 streams 100 kHz binary frames directly to the Host laptop!\n- Diagnostic Mode (USB_SEL_PASS = LOW): Connects Host USB to STM32 MCU for pump firmware updates"
		(at 60.0 130.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a5020001-0000-4000-8000-000000000003")
	)

	(text "=== USB-C SBU I2C AUTO-CROSS SWITCH (U11: FSA2268 / TMUX154E) ===\nRoutes SBU1 and SBU2 on J2_MR1 to STM32 I2C pins (SBU_I2C_SCL / SBU_I2C_SDA).\nOperates in conjunction with the ESP32-S3 firmware SBU auto-polarity state machine,\nallowing robust bidirectional control and telemetry over the sideband pins!"
		(at 60.0 175.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a5020001-0000-4000-8000-000000000004")
	)
)
