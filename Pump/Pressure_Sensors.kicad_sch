	(text "=== PRESSURE TRANSDUCER 1 (U6: ABP2MANT015PG2A3XX) ===\nMeasurement: Cis Chamber Pump Outlet / In-line Feed Pressure\nRange: 0 to 15 psi (0 to 103 kPa gauge)\nResolution: 24-bit delta-sigma, +/- 0.25% FSS accuracy\nPort Type: 1/8\" axial hose barb connected in-line with TUBE_FEED (FEP)\nI2C Address: 0x28 (Standard Honeywell I2C Address)\nPurpose: Detects fluidic resistance, pore clogging, bubble formation, and priming pressure"
		(at 60.0 30.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a3020001-0000-4000-8000-000000000001")
	)

	(text "=== PRESSURE TRANSDUCER 2 (U7: ABP2MANT005PG2A3XX) ===\nMeasurement: Trans Chamber Recirculation / Waste Pressure\nRange: 0 to 5 psi (0 to 34.5 kPa gauge)\nResolution: 24-bit delta-sigma, +/- 0.25% FSS accuracy\nPort Type: 1/8\" axial hose barb connected in-line with TUBE_TRANS_LINE (PEEK)\nI2C Address: 0x38 (Alternate I2C Address)\nPurpose: Monitors backpressure, prevents membrane ballooning, verifies waste flow"
		(at 60.0 85.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a3020001-0000-4000-8000-000000000002")
	)

	(text "=== SAFETY & OVERPRESSURE INTERLOCK ===\nOpen-drain interrupt line (PRESS_ALERT_) asserted if line pressure exceeds\nprogrammed ceiling (e.g. > 10 psi on Cis feed), triggering immediate pump pause\nto protect fragile silicon nanopore chip and cast silicone gaskets from blowout."
		(at 60.0 140.0 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a3020001-0000-4000-8000-000000000003")
	)
)
