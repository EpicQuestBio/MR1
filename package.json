{
  "name": "app",
  "version": "1.0.0",
  "description": "MR1 Nanopore Reader (MR1) - Open-source solid-state and biological nanopore sequencer, low-noise transimpedance amplifier, and automated fluidic control system",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "python run_tests.py",
    "test:e2e": "python tests/test_exports_e2e.py",
    "export": "python scripts/export_manager.py --all",
    "export:cad": "python src/main.py all",
    "export:kicad": "python scripts/export_manager.py --kicad",
    "export:wiring": "python scripts/export_manager.py --wiring",
    "export:firmware": "python scripts/export_manager.py --firmware",
    "export:check": "python scripts/export_manager.py --check",
    "render:flythrough": "xvfb-run python3 scripts/render_flythrough.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LokiMetaSmith/mr1.git"
  },
  "keywords": [
    "nanopore",
    "sequencer",
    "solid-state-nanopore",
    "dna-sequencing",
    "open-source-hardware",
    "build123d",
    "kicad",
    "esp32-s3",
    "microfluidics",
    "transimpedance-amplifier"
  ],
  "author": "Lawrence R. Kincheloe III / Molecular Reality Corp.",
  "license": "AGPL-3.0-or-later",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/LokiMetaSmith/mr1/issues"
  },
  "homepage": "https://github.com/LokiMetaSmith/mr1#readme",
  "dependencies": {
    "openscad-wasm": "git+https://github.com/LokiMetaSmith/Corkscrew-Filter.git"
  }
}